<section class="section" aria-labelledby="top-dishes">
  <div class="container">
    <h2 id="top-dishes">Top Veg Dishes in Paschim Vihar</h2>
    <div class="grid grid-4">
      {% for dish in site.dishes %}
      <article class="card dish-card">
        <img class="dish-image" src="/assets/images/{{ dish.image }}" width="640" height="480" loading="lazy" decoding="async" alt="{{ dish.alt }}">
        <div class="dish-row">
          <h3><a href="/menu/{{ dish.slug }}/">{{ dish.name }}</a></h3>
          <span class="price">?{{ dish.price }}</span>
        </div>
        {% if dish.badge %}<span class="badge">{{ dish.badge }}</span>{% endif %}
        <p>{{ dish.description }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-accent" aria-labelledby="combo-title">
  <div class="container">
    <h2 id="combo-title">Featured Combos</h2>
    <div class="grid grid-2">
      {% for combo in site.combos %}
      <article class="card">
        <div class="dish-row">
          <h3>{{ combo.name }}</h3>
          <span class="price">?{{ combo.price }}</span>
        </div>
        {% if combo.badge %}<span class="badge">{{ combo.badge }}</span>{% endif %}
        <p>{{ combo.description }}</p>
        <a class="btn btn-secondary" href="{{ site.orderUrl }}" target="_blank" rel="noopener noreferrer">Order This Combo</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

