<section class="hero" aria-labelledby="page-title">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">{{ page.h1 }}</span></li>
      </ol>
    </nav>
    <p class="eyebrow">{{ page.eyebrow }}</p>
    <h1 id="page-title">{{ page.h1 }}</h1>
    <p class="subtext">{{ page.subtext }}</p>
  </div>
</section>

<section class="section" aria-labelledby="page-content-title">
  <div class="container">
    <article class="card">
      <h2 id="page-content-title">{{ page.contentTitle }}</h2>
      {% for paragraph in page.paragraphs %}<p>{{ paragraph | safe }}</p>{% endfor %}
      {% if page.areas %}
      <ul class="area-list">
        {% for area in site.areaServed %}<li>{{ area }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if page.contactForm %}
      <form class="contact-form" action="mailto:{{ site.email }}" method="post" enctype="text/plain" aria-label="Contact form">
        <div class="form-grid">
          <div>
            <label for="name">Full Name</label>
            <input id="name" name="name" type="text" required>
          </div>
          <div>
            <label for="phone">Phone Number</label>
            <input id="phone" name="phone" type="tel" required>
          </div>
          <div class="full">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" required></textarea>
          </div>
        </div>
        <button class="btn btn-secondary" type="submit">Send Inquiry</button>
      </form>
      {% endif %}
      <p class="button-row">
        <a class="btn btn-primary" href="{{ site.orderUrl }}" target="_blank" rel="noopener noreferrer">Order on Zomato</a>
        <a class="btn btn-secondary" href="/menu/">View Menu</a>
      </p>
    </article>
  </div>
</section>

