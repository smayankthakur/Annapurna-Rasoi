{
  "name": "annapurna-rasoi",
  "version": "1.0.0",
  "private": true,
  "description": "SEO-optimized static website for Annapurna Rasoi",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/minify-assets.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"**/*.html\"",
    "lint:css": "stylelint \"assets/css/style.css\"",
    "lint:js": "eslint \"assets/js/script.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml,yaml}\"",
    "validate": "npm run build && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "htmlhint": "^1.4.6",
    "nunjucks": "^3.2.4",
    "prettier": "^3.5.3",
    "sharp": "^0.33.5",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0"
  }
}
